# Paths are relative to the repository root unless absolute.
MODEL_CONFIG_PATH=config/models.yaml
DATA_DIR=data

# Input filenames inside DATA_DIR.
TRAIN_LABELS_FILENAME=train_limpo.csv
VALID_LABELS_FILENAME=valid_limpo.csv
TRAIN_TFIDF_FILENAME=X_train_tfidf.npz
VALID_TFIDF_FILENAME=X_valid_tfidf.npz

# Generated output locations and filenames.
MODELS_DIR=artifacts/models
EVALUATION_DIR=artifacts/evaluation
MODEL_FILENAME_TEMPLATE={target}.joblib
METRICS_FILENAME_TEMPLATE={model}.json
TUNING_FILENAME=tuning.json
